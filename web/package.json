{
  "name": "overdrive-windows",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:ps5": "vite build -c vite.ps5.config.ts",
    "start": "electron .",
    "test:desktop": "node --test desktop/core.test.cjs desktop/kyty.test.cjs desktop/main.test.cjs",
    "dist:windows": "npm run build && electron-builder --win --x64 --publish never",
    "smoke:desktop": "electron --no-sandbox --ozone-platform=headless desktop/smoke.cjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "clsx": "^2.1.1",
    "lucide-react": "^1.51.0",
    "motion": "^14.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "electron": "43.7.5",
    "electron-builder": "^26.15.3"
  },
  "productName": "Overdrive Windows",
  "main": "desktop/main.cjs",
  "license": "GPL-3.0-or-later",
  "description": "Overdrive storefront for Windows with catalog import and persistent file downloads",
  "author": "Overdrive contributors and onlykappa",
  "build": {
    "appId": "com.onlykappa.overdrive.windows",
    "productName": "Overdrive Windows",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/*.cjs",
      "package.json",
      "NOTICE",
      "LICENSE",
      "LICENSE-ATTRIBUTION",
      "WINDOWS.md",
      "!desktop/*.test.cjs",
      "!desktop/smoke.cjs"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "Overdrive-Windows-${version}-${arch}.${ext}"
  }
}
